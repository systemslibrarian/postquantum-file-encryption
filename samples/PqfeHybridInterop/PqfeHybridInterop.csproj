<Project Sdk="Microsoft.NET.Sdk">

  <!-- CI-only cross-implementation driver for the interop job (.github/workflows/ci.yml).
       Mirrors samples/pqfe-wasm/examples/pqfe_io.rs so .NET and Rust can round-trip hybrid
       recipient containers both directions. Not shipped: the `pqfe` tool is passphrase-only. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Pqfe.HybridInterop</RootNamespace>
    <AssemblyName>pqfe-hybrid-interop</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsPublishable>true</IsPublishable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/PostQuantum.FileEncryption.Hybrid/PostQuantum.FileEncryption.Hybrid.csproj" />
  </ItemGroup>

</Project>
